# Secrets — never commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.Python

# Generated reports / assets. Ignore the instance dir EXCEPT the scraped roster
# media (jersey #s + public headshot URLs) — it must ship so photos render on a
# host with an ephemeral instance dir (e.g. Render).
instance/*
!instance/roster_media.json
*.pdf
!docs/**/*.pdf

# Reference R Shiny source — contains hardcoded RDS credentials; do not commit
src/

# Original email asset drop (videos, PDFs, report leftovers) — needed assets
# were already copied into app/static/reports/
Re_ PAW scripts/

# Local-only: agent memory and subagent-driven-development scratch
memory/
.superpowers/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Warehouse backups (scripts/backup_warehouse.py defaults OUTSIDE the repo;
# this is a safety net in case --out is ever pointed inside it).
backups/
*.sql.gz
