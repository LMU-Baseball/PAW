# Copy to .env and fill in. NEVER commit the real .env.

# LMU Baseball analytics database (AWS RDS MySQL)
MYSQL_HOST=your-db-host.rds.amazonaws.com
MYSQL_PORT=3306
MYSQL_USER=your-user
MYSQL_PASSWORD=your-password
MYSQL_DB=lmubaseball

# HitTrax practice-data FTPS feed (used by newer data pipeline)
FTPS_HOST=ftpjobs.hittraxbaseball.com
FTPS_PORT=21
FTPS_USER=your-ftps-user
FTPS_PASSWORD=your-ftps-password
FTPS_REMOTE_DIR=/

# Trackman SFTP feed (app/ingest loaders)
TM_SFTP_HOST=your-trackman-sftp-host
TM_SFTP_PORT=22
TM_SFTP_USER=your-sftp-user
TM_SFTP_PASS=your-sftp-password
TM_SFTP_DIR=/

# HitTrax FTPS feed (app/ingest loaders)
HT_FTPS_HOST=ftpjobs.hittraxbaseball.com
HT_FTPS_PORT=21
HT_FTPS_USER=your-ftps-user
HT_FTPS_PASSWORD=your-ftps-password
HT_FTPS_REMOTE_DIR=/

# Flask session signing key (generate a random value for production)
SECRET_KEY=change-me

# Set to "production" on a real deployment to enable Secure session cookies,
# HSTS, and the SECRET_KEY boot guard. Leave UNSET until HTTPS is working --
# a Secure cookie sent over plain HTTP is dropped by the browser and login
# will appear to do nothing.
PAW_ENV=

# App DB for user accounts / roles (Flask-SQLAlchemy). Optional locally —
# defaults to sqlite:///…/instance/paw_app.db. Required for durable logins
# in production (e.g. a small schema on the same RDS):
# APP_DATABASE_URL=mysql+pymysql://app-user:your-password@your-db-host.rds.amazonaws.com:3306/paw_app

# Comma-separated LMU emails that get the coach role on self-registration
# (case-insensitive). Anyone else who registers becomes a player.
PAW_COACH_EMAILS=

# Team code required at self-registration (case-insensitive), so an LMU email
# alone isn't enough to see the whole team's data -- give this out to the
# roster each season. Leave blank to allow any @lmu.edu/@lion.lmu.edu email to
# register with no code (today's behavior).
PAW_TEAM_CODE=

# A SEPARATE code (case-insensitive) that also self-registers, but as a coach
# instead of a player -- give this out to coaches only, never the roster.
# Works alongside PAW_COACH_EMAILS (whichever grants coach role is enough,
# not both) but doesn't need an allowlist maintained ahead of time. Leave
# blank to disable this path (coach role then comes from PAW_COACH_EMAILS
# only, today's behavior).
PAW_COACH_CODE=
